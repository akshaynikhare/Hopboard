# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# FastAPI Cloud link file (contains app/team ids for this machine)
.fastapicloud/

# Local tool state
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp

# Env
.env
.env.*
!.env.example

# The app still ships with zero RUNTIME dependencies, and that has not changed.
# What changed is that the DEPLOY now has one: tools/build.mjs bundles the site
# with esbuild, so a floating esbuild version is a floating bundle, and "the
# build is reproducible" stops being true. The lock file is therefore committed
# — and `npm ci` in the workflows requires it to exist at all.
node_modules/

# Scratch screenshots from local UI checks — output, not source
.shots/

# The assembled deploy. Built by tools/build.mjs, in CI or locally — output.
_site/

# Generated package manifests — output of tools/manifest.mjs
dist/

# npm pack output
*.tgz
